<?xml version="1.0" encoding="utf-8"?>
<!-- Quick settings opened by the remote's Settings button. With glass and a quick_panel it is a Control Center sheet docked to
     the right edge (24 dp in from the edge, top and bottom): header, round controls, module grid. Otherwise QuickSettingsActivity
     shrinks it to the old panel under the Settings pill and fills @id/rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="280dp"
        android:minWidth="220dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="8dp"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:visibility="gone">

            <TextClock
                android:id="@+id/qp_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="#F5F7FA"
                android:textSize="56sp" />

            <TextClock
                android:id="@+id/qp_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:format12Hour="EEEE d MMM"
                android:format24Hour="EEEE d MMM"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="#C7FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- quick_panel_credit: the theme's credit line, bottom-left of the sheet. Not focusable, not clickable, not announced. -->
        <TextView
            android:id="@+id/qp_credit"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|start"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:focusable="false"
            android:clickable="false"
            android:importantForAccessibility="no"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
