<?xml version="1.0" encoding="utf-8"?>
<!-- Quick panel module on a glass panel: 12 % white at rest, the white capsule rounded rect when focused (radius concentric with the panel). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F2FFFFFF" android:endColor="#E0FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
