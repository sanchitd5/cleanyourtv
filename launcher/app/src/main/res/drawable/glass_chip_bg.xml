<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row or choice on a glass sheet (HOME-DESIGN.md 19.5): chip fill at rest, white capsule when focused, ice rim when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#CCFFFFFF" android:endColor="#B3FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F2FFFFFF" android:endColor="#E0FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#298FC1FF" />
            <stroke android:width="1.5dp" android:color="#8FC1FF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
